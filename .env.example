# Dr. Muhammad Saad Obhaya Medical Clinic — Environment Configuration
# Copy this file to .env for local development or set variables in Cloudflare Pages / Vercel settings.

# Public Supabase Client Config (Safe for Frontend)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Side Supabase Key (For Edge Functions / Backend Only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Email Provider Configuration (Resend - Server-side only)
RESEND_API_KEY=re_your_resend_api_key_here
DOCTOR_EMAIL=drsaadobhaya@gmail.com
SENDER_EMAIL=notifications@yourclinicdomain.com

# Site URL Configuration
SITE_URL=http://localhost:5173

# Mode Flag (Set true to force Demo / Offline Mode)
VITE_DEMO_MODE=true
